# Copy this file to .env.testing (gitignored) and fill in real values.
# Loaded automatically by `php artisan test` / phpunit when APP_ENV=testing
# - and it REPLACES .env entirely for that run, so it needs its own APP_KEY
# too. Generate one with: php artisan key:generate --env=testing
#
APP_KEY=
#
# Prefer sqlite if your PHP has the pdo_sqlite extension - no service to run:
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:
#
# Otherwise point at a local MySQL test database:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=authnauth_test
DB_USERNAME=authnauth_user
DB_PASSWORD=
